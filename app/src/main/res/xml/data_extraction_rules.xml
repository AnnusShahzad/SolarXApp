<?xml version="1.0" encoding="utf-8"?>
<!-- The saved Pocket WiFi serial is the dongle's password, so it never leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
